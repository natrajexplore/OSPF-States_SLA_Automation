server {
    listen ${UI_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # REST + Server-Sent Events (run logs, live events): no buffering, long reads
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # the page itself is never cached, so a browser always loads the current build after an update
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }

    # build assets have a content hash in their name: safe to cache for good
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
}
