# Copy to .env and adjust. Consumed by docker-compose. Never commit .env.

# --- EVE-NG REST API (reachable from the container via network_mode: host) ---
OSPF_EVENG_URL=http://192.168.186.128
OSPF_EVENG_USER=admin
OSPF_EVENG_PASS=eve
OSPF_LAB_PATH=/ospf-sla.unl

# --- Router credentials (baseline config creates this local user) ---
OSPF_DEVICE_USER=lab
OSPF_DEVICE_PASS=lab123
OSPF_DEVICE_SECRET=lab123

# Fall back to the EVE-NG telnet console port if SSH to the MGMT IP fails
OSPF_CONSOLE_FALLBACK=true

# --- Kafka / monitoring (Docker Desktop stack: docker-compose.monitoring.yml) ---
# Windows IP reachable from the EVE VM (Kafka's EXTERNAL advertised listener)
KAFKA_ADVERTISED_HOST=192.168.186.1
# Backend (on EVE VM) -> Kafka on Windows. Leave empty to disable publishing.
OSPF_KAFKA_BOOTSTRAP=192.168.186.1:9094
OSPF_POLL_INTERVAL=20
OSPF_GRAFANA_URL=http://192.168.186.1:3000
OSPF_KAFKA_UI_URL=http://192.168.186.1:8080
OSPF_PROMETHEUS_URL=http://192.168.186.1:9090
