{
 "uid": "ospf-sla",
 "title": "OSPF SLA & States",
 "tags": [
  "ospf",
  "eve-ng"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Full adjacencies (sum of routers' views)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(ospf_neighbor_full)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Neighbors NOT Full",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "count(ospf_neighbor_full == 0) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Routers reachable",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(ospf_router_reachable)",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "IP SLA RTT (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_sla_rtt_milliseconds",
     "legendFormat": "{{router}} op {{operation}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 50
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "IP SLA status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_sla_up",
     "legendFormat": "{{router}} op {{operation}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "FAIL",
         "color": "red"
        },
        "1": {
         "text": "OK",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "state-timeline",
   "title": "OSPF neighbor state (per router view)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_neighbor_state",
     "legendFormat": "{{router}} -> {{neighbor}} ({{interface}})",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "Attempt",
         "color": "orange",
         "index": 1
        },
        "2": {
         "text": "Init",
         "color": "orange",
         "index": 2
        },
        "3": {
         "text": "2-Way",
         "color": "yellow",
         "index": 3
        },
        "4": {
         "text": "ExStart",
         "color": "yellow",
         "index": 4
        },
        "5": {
         "text": "Exchange",
         "color": "blue",
         "index": 5
        },
        "6": {
         "text": "Loading",
         "color": "blue",
         "index": 6
        },
        "7": {
         "text": "Full",
         "color": "green",
         "index": 7
        }
       }
      }
     ],
     "custom": {
      "fillOpacity": 80
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Interface roles (DR / BDR / DROTH / P2P) and areas",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_interface_role == 1",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "Value": true
      }
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Neighbor transitions (5m increase, by target state)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (to_state) (increase(ospf_neighbor_transitions_total[5m]))",
     "legendFormat": "{{to_state}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "OSPF routes in RIB by type (watch O IA appear/withdraw)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_routes",
     "legendFormat": "{{router}} {{type}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "IP SLA latency (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_sla_rtt_milliseconds",
     "legendFormat": "{{router}} op {{operation}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "DR/BDR role changes (5m increase)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (router, interface, to_state) (increase(ospf_interface_role_changes_total[5m]))",
     "legendFormat": "{{router}} {{interface}} -> {{to_state}}",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "table",
   "title": "Scenario runs (backend config pushes)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 29,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_config_changes_total",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Interface cost (steering: watch R4 Ethernet1/0)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_interface_cost",
     "legendFormat": "{{router}} {{interface}} (area {{area}})",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "state-timeline",
   "title": "BFD session state",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 37,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "ospf_bfd_up",
     "legendFormat": "{{router}} -> {{neighbor}} ({{interface}})",
     "refId": "A",
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Down",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "Up",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "custom": {
      "fillOpacity": 80
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "legend": {
     "showLegend": false
    }
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "name": "Scenario runs",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "enable": true,
    "iconColor": "purple",
    "expr": "changes(ospf_config_last_change_timestamp_seconds[10s]) > 0",
    "titleFormat": "{{scenario}} {{mode}}",
    "step": "10s",
    "useValueForTime": false
   }
  ]
 }
}